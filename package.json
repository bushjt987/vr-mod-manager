{
  "name": "vr-mod-manager",
  "version": "1.0.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "release": "npm run dist && node scripts/release.mjs",
    "e2e": "vite build --config scripts/e2e.vite.config.ts && electron out/e2e/e2e-install.mjs",
    "scan": "vite build --config scripts/scan.vite.config.ts && electron out/e2e/scan-existing.mjs",
    "docs:table": "vite build --config scripts/table.vite.config.ts && node out/e2e/catalog-table.mjs",
    "check-sources": "vite build --config scripts/sources.vite.config.ts && node out/e2e/check-sources.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "build": {
    "appId": "com.vrmm.app",
    "productName": "VR Mod Manager",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "package.json",
      "node_modules/adm-zip/**",
      "node_modules/7zip-min/**",
      "node_modules/7zip-bin/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bushjt987",
        "repo": "vr-mod-manager",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "artifactName": "VR-Mod-Manager-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "VR Mod Manager"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/7zip-bin/**"
    ]
  },
  "dependencies": {
    "7zip-min": "^3.0.1",
    "adm-zip": "^0.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.11",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
